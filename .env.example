# ── Claude (Anthropic) ──────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...
# Modelo por defecto: claude-opus-4-8. Si el volumen de mensajes es alto y
# el costo importa, prueba claude-sonnet-5 o claude-haiku-4-5.
CLAUDE_MODEL=claude-opus-4-8

# ── WhatsApp Cloud API (Meta) ───────────────────────────────────────
# developers.facebook.com > tu App > WhatsApp > API Setup
WHATSAPP_ACCESS_TOKEN=EAAG...
WHATSAPP_PHONE_NUMBER_ID=1234567890
# Token que tu inventas para verificar el webhook (cualquier string secreto)
WHATSAPP_VERIFY_TOKEN=cambia-esto-por-un-secreto
# Version de la Graph API
WHATSAPP_API_VERSION=v21.0

# ── Google Calendar ─────────────────────────────────────────────────
# Ruta al JSON de la cuenta de servicio de Google Cloud (ver README)
GOOGLE_SERVICE_ACCOUNT_KEY_PATH=./google-service-account.json
# El calendario debe estar compartido con el email de la cuenta de servicio
# (client_email dentro del JSON) con permiso "Realizar cambios en eventos"
GOOGLE_CALENDAR_ID=tuesposa@gmail.com

# Zona horaria del negocio (IANA), usada para horarios y recordatorios
BUSINESS_TIMEZONE=America/Caracas

# ── Recordatorios ───────────────────────────────────────────────────
# Nombre de la plantilla de WhatsApp aprobada por Meta para recordatorios
# (necesaria porque los recordatorios se envian fuera de la ventana de 24h)
WHATSAPP_REMINDER_TEMPLATE=recordatorio_cita
# Horas antes de la cita para enviar el recordatorio
REMINDER_HOURS_BEFORE=24
# Cada cuanto corre el cron que revisa citas pendientes de recordatorio (cron expr)
REMINDER_CRON_SCHEDULE=*/15 * * * *

# ── Escalamiento a humano ────────────────────────────────────────────
# Nombre de la plantilla de WhatsApp aprobada por Meta para notificar a
# Joselyn cuando el bot escala un caso (mismo motivo que los recordatorios:
# es un mensaje que inicia el negocio, no el cliente).
# El número de WhatsApp de Joselyn se configura en src/businessConfig.ts
# (humanContact.whatsappNumber), no aquí.
WHATSAPP_ESCALATION_TEMPLATE=notificacion_escalamiento

# ── Servidor ─────────────────────────────────────────────────────────
PORT=3000
