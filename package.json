{
  "name": "ws-depicejas-bot",
  "version": "1.0.0",
  "description": "Bot de WhatsApp con Claude para atencion al cliente, agendamiento de citas y recordatorios",
  "main": "src/app.ts",
  "type": "commonjs",
  "scripts": {
    "dev": "wrangler dev --port 3000",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit -p tsconfig.worker.json",
    "chat": "ts-node --transpile-only src/cli.ts",
    "chat:mock": "ts-node --transpile-only src/cli-mock.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.32.0",
    "better-sqlite3": "^11.3.0",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "googleapis": "^126.0.0",
    "hono": "^4.6.9",
    "mercadopago": "^2.0.9",
    "node-cron": "^3.0.3",
    "nodemailer": "^6.9.15"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.11",
    "@types/express": "^4.17.21",
    "@types/node": "^20.11.0",
    "@types/node-cron": "^3.0.11",
    "@types/nodemailer": "^6.4.16",
    "@cloudflare/workers-types": "^4.20241004.0",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.6.3",
    "wrangler": "^3.86.0"
  },
  "engines": {
    "node": ">=18"
  }
}
